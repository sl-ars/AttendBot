# Required — the bot refuses to start without these.
# On Coolify: set them in the resource's Environment UI instead of this file.
TG_BOT_TOKEN=1234567890:XXXXXXXXXXXXXXXXXXXXXXXX
TG_CHAT_ID=1

# Attendance page — no default in code, set it here (or via /url in Telegram).
BASE_URL=https://pge.kbtu.kz/RegistrationOnline

# Optional one-time seed for the state file — after first start, credentials
# are managed in Telegram via: /login <логин> <пароль>
#WSP_LOGIN=l_student
#WSP_PASSWORD=password

# Optional overrides (defaults shown) — uncomment only what you need.

# Selenium grid image (multi-arch: amd64 + arm64).
# Alternative: seleniarm/standalone-chromium:latest
#SELENIUM_IMAGE=selenium/standalone-chrome:latest

# Selenium grid memory ceiling (docker mem_limit syntax: 512m, 1g, 1.5g…)
#SELENIUM_MEM_LIMIT=1g

#REMOTE_URL=http://selenium:4444/wd/hub
#STATE_PATH=/data/state.json
#LOG_LEVEL=INFO
